<!doctype html>
<html>
    <head>
        <meta name="viewport" content="width=device-width, maximum-scale=1, initial-scale=1, user-scalable=0">
        <meta charset="utf-8">
        <!-- Always force latest IE rendering engine or request Chrome Frame -->
        <meta content="IE=edge,chrome=1" http-equiv="X-UA-Compatible">
        <meta itemprop="config-currency" content="USD">

        <!-- Use title if it's in the page YAML frontmatter -->
        <title>SparkMeter </title>

        <link href="%% APPLICATION_CSS %%" media="screen" rel="stylesheet" type="text/css" />
        <script src="%% VENDOR_JS %%" type="text/javascript"></script>
        <script src="%% APPLICATION_JS %%" type="text/javascript"></script>
    </head>
    <body>
      <div class="panel panel-default">
        <div class="panel-heading">
          <h1 class="panel-title">Keyword help</h1>
        </div>
        <div class="panel-body">
          <h4>Keyword syntax help for SMS messages</h4>
          <table class="table">
            <thead>
              <tr>
                <th class="col-sm-2">Keyword</th>
                <th class="col-sm-6">Description</th>
                <th class="col-sm-4">Example</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td class="col-sm-2">{customer_name}</td>
                <td class="col-sm-6">Name of the customer.</td>
                <td class="col-sm-4">John Doe</td>
              </tr>
              <tr>
                <td class="col-sm-2">{customer_code}</td>
                <td class="col-sm-6">Code of the customer.</td>
                <td class="col-sm-4">CC1618</td>
              </tr>
              <tr>
                <td class="col-sm-2">{credits_balance}</td>
                <td class="col-sm-6">Credit balance for the customer.</td>
                <td class="col-sm-4">10.34</td>
              </tr>
              <tr>
                <td class="col-sm-2">{debt_balance}</td>
                <td class="col-sm-6">Debt balance for the customer.</td>
                <td class="col-sm-4">42.91</td>
              </tr>
              <tr>
                <td class="col-sm-2">{current_tariff_name}</td>
                <td class="col-sm-6">Name of Tariff used by the meter.</td>
                <td class="col-sm-4">ET60</td>
              </tr>
              <tr>
                <td class="col-sm-2">{serial}</td>
                <td class="col-sm-6">Meter serial number.</td>
                <td class="col-sm-4">SM15R-01-00DDBA11</td>
              </tr>
              <tr>
                <td class="col-sm-2">{is_running_plan}</td>
                <td class="col-sm-6">If the tariff used includes a plan, has it been paid? (yes/no)</td>
                <td class="col-sm-4">yes</td>
              </tr>
              <tr>
                <td class="col-sm-2">{plan_balance}</td>
                <td class="col-sm-6">For tariffs with plans, the Plan balance.</td>
                <td class="col-sm-4">17.26</td>
              </tr>
              <tr>
                <td class="col-sm-2">{last_energy}</td>
                <td class="col-sm-6">Last energy value read for the meter, in kWh.</td>
                <td class="col-sm-4">8.663 kWh</td>
              </tr>
              <tr>
                <td class="col-sm-2">{operating_mode}</td>
                <td class="col-sm-6">Operating mode of the meter (On/Off/Auto).</td>
                <td class="col-sm-4">Auto</td>
              </tr>
              <tr>
                <td class="col-sm-2">{total_cycle_energy}</td>
                <td class="col-sm-6">Total amount of energy used since the beginning of the month, in kWh.</td>
                <td class="col-sm-4">2.804 kWh</td>
              </tr>
              <tr>
                <td class="col-sm-2">{last_transaction_amount}</td>
                <td class="col-sm-6">Amount of the last transaction placed for this customer.</td>
                <td class="col-sm-4">25.00</td>
              </tr>
              <tr>
                <td class="col-sm-2">{last_transaction_vendor}</td>
                <td class="col-sm-6">Name of vendor used for the last transaction placed for this customer.</td>
                <td class="col-sm-4">Jane Doe</td>
              </tr>
              <tr>
                <td class="col-sm-2">{last_transaction_creation_datetime}</td>
                <td class="col-sm-6">Time when the last transaction for this customer was placed.</td>
                <td class="col-sm-4">3/31/16, 4:01 PM</td>
              </tr>
              <tr>
                <td class="col-sm-2">{last_transaction_source}</td>
                <td class="col-sm-6">Source of the last transaction placed for this customer (cash/bonus).</td>
                <td class="col-sm-4">cash</td>
              </tr>
              <tr>
                <td class="col-sm-2">{last_transaction_status}</td>
                <td class="col-sm-6">Status of the last transaction placed for this customer (not processed/processed/error).</td>
                <td class="col-sm-4">processed</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
      </body>
</html>
