            <ul class="dropdown-menu">
              <li><a ng-click="vm.openModal('Edit', alert)" data-action="edit">Edit</a></li>
              <li class="divider"></li>
              <li><a ng-click="vm.openModal('Delete', alert)">Delete</a></li>
            </ul>
          </div>
        </td>
      </tr>
    </tbody>
  </table>
  <button class="btn btn-default"
          ng-disabled="vm.alerts.length === vm.eventTypes.length"
