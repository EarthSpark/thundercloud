  </div>
</div>


<div class="form-group tariff_type blockrate hide">
  <label class="control-label col-lg-2">Block rates</label>
  <div class="col-md-5" data-box="tariff-blockrates">

  <table id="tariff-blockrates" class='table table-striped table-bordered table-hover table-normal dataTable '>
      <thead class="">
      <tr>
          <th>min total. energy (kWh)</th>
          <th>max total. energy (kWh)</th>
          <th>USD per kWh</th>
          <th></th>
      </tr>    </thead>
    <tfoot><tr data-object="{}">
  <td colspan="4">
      <button type="button" class="btn btn-default" id="add-modal" href="#" data-toggle="modal" data-target="#blockrateModal" data-title="Add a tariff block rate"> Add a tariff block rate</button>
  </td>
</tr>
</tfoot>
    <tbody></tbody>
  </table>

<div class="modal" id="blockrateModal" tabindex="-1" role="dialog" aria-labelledby="blockrateModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg">
