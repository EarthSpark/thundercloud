    </label>
  </div>
</div>


<div class="form-group tariff_type flat">
  <label class="control-label col-lg-2" for="flat_price">Flat Rate</label>
  <div class="input-group col-lg-3">
    <input class="form-control numeric no-negative" id="flat_price" name="flat_price" type="text" value="0.0">
